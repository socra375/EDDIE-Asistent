# Copy this file to .env and fill in the values you plan to use.
# Never commit the real .env file — every secret here must stay server-side only.

# --- AI providers (at least one) ---

# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Anthropic Console: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Groq Console: https://console.groq.com/keys (free tier).
# Also works as an automatic backup: if the chosen provider fails before
# answering (quota, overload, timeout), Groq answers instead.
GROQ_API_KEY=
# Optional: override Groq's model (default openai/gpt-oss-120b). If Groq
# retires the model, Eddie picks another available one on its own.
GROQ_MODEL=
# The same key powers voice recognition: Eddie transcribes what you say with
# Whisper on Groq (default whisper-large-v3-turbo). Optional override, e.g.
# whisper-large-v3 (a bit more accurate, a bit slower).
GROQ_STT_MODEL=

# --- Web search (optional) ---
# Eddie searches the web with Tavily even without a key (keyless mode, low
# limit). A free key (https://app.tavily.com, 1,000 searches a month) lifts it.
TAVILY_API_KEY=

# --- Eddie's voice: ElevenLabs text to speech (optional) ---
# https://elevenlabs.io/app/settings/api-keys (free plan: 10,000 credits a
# month, ~20 min with the default Flash model). Without it Eddie speaks with
# the browser's voice. Note: the free plan can't use Voice Library voices
# through the API — add the voice to "My Voices" or use a paid plan.
ELEVENLABS_API_KEY=
# Optional: Eddie's voice (default bUQeiO7gn4ehGuSnZf26) and model (default
# eleven_flash_v2_5; eleven_multilingual_v2 sounds a bit better, costs 2x).
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# --- Google Sign-In + Calendar + Drive (optional) ---
# Without these, Eddie works exactly as before: no login, everything
# stored in the browser's localStorage. See README.md "Cuenta de Google"
# for how to create these in Google Cloud Console.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# The frontend's own URL — where the OAuth callback redirects back to
# after a successful login.
APP_URL=http://localhost:5173

# Encrypts the stored Google access (AES-256-GCM) and is required to
# connect Gmail (Conectores → Conectar Gmail). A long random string, at
# least 16 characters; don't change it later or saved access stops working.
CONNECTOR_SECRET=

# --- Database (required only if using Google Sign-In) ---
# Postgres connection string, e.g. from Neon (https://neon.tech, free tier).
DATABASE_URL=

# Port for the local Express dev server (server/dev-server.js). Optional.
PORT=8787
