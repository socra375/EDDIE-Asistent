# Copy this file to .env and fill in the values you plan to use.
# Never commit the real .env file — every secret here must stay server-side only.

# --- AI providers (at least one) ---

# Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional: model Modo Vigilancia (camera vision) uses with Gemini (default gemini-flash-latest),
# the Claude model it falls back to (default claude-haiku-4-5-20251001) and how many frames a
# minute one address may send (default 20).
GEMINI_VISION_MODEL=
CLAUDE_VISION_MODEL=
VISION_MAX_PER_MINUTE=
# Opcional: modelo de embeddings para la memoria de conversaciones (por defecto gemini-embedding-001)
GEMINI_EMBEDDING_MODEL=

# Anthropic Console: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Groq Console: https://console.groq.com/keys (free tier).
# Also works as an automatic backup: if the chosen provider fails before
# answering (quota, overload, timeout), Groq answers instead.
GROQ_API_KEY=
# Optional: override Groq's model (default openai/gpt-oss-120b). If Groq
# retires the model, Eddie picks another available one on its own.
GROQ_MODEL=
# The same key powers voice recognition: Eddie transcribes what you say with
# Whisper on Groq (default whisper-large-v3-turbo). Optional override, e.g.
# whisper-large-v3 (a bit more accurate, a bit slower).
GROQ_STT_MODEL=

# --- Web search (optional) ---
# Eddie searches the web with Tavily even without a key (keyless mode, low
# limit). A free key (https://app.tavily.com, 1,000 searches a month) lifts it.
# Opcional: API de YouTube Data v3 para que Eddie elija el video que reproduce
YOUTUBE_API_KEY=
TAVILY_API_KEY=

# --- Eddie's voice: ElevenLabs text to speech (optional) ---
# https://elevenlabs.io/app/settings/api-keys (free plan: 10,000 credits a
# month, ~20 min with the default Flash model). Without it Eddie speaks with
# the browser's voice. Note: the free plan can't use Voice Library voices
# through the API — add the voice to "My Voices" or use a paid plan.
ELEVENLABS_API_KEY=
# Optional: Eddie's voice (default bUQeiO7gn4ehGuSnZf26) and model (default
# eleven_flash_v2_5; eleven_multilingual_v2 sounds a bit better, costs 2x).
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
# Optional: how the voice is delivered, from 0 to 1. Lower stability = more
# expressive/varied intonation (default 0.45); similarity (0.8) and style (0.15).
ELEVENLABS_STABILITY=
ELEVENLABS_SIMILARITY=
ELEVENLABS_STYLE=
# Optional: more voices to pick in Configuración → Voz, as Name:VoiceID pairs
# separated by commas (e.g. Mayordomo:abc123...,Cercano:def456...). Up to 12.
ELEVENLABS_VOICES=

# --- GitHub (optional): repos, activity, issues and PRs from the chat ---
# A fine-grained personal access token (GitHub > Settings > Developer
# settings > Fine-grained tokens): read on Contents, Issues, Pull requests
# and Metadata; add Issues read/write so Eddie can create issues and
# comments (always after your confirmation). Only for the owner: the tools
# answer only to a signed-in user whose Google email is in EDDIE_OWNER_EMAIL
# (comma-separated). Set both or neither; never paste the token in a chat.
GITHUB_TOKEN=
EDDIE_OWNER_EMAIL=

# --- Notion (optional): search, read and write your pages from the chat ---
# Create an internal integration at https://www.notion.so/profile/integrations
# (capabilities: read, update and insert content), copy its secret here, and
# share the pages you want Eddie to reach with it (page menu > Connections).
# Like GitHub it only answers to the owner (EDDIE_OWNER_EMAIL, above), and it
# only creates or adds things after your confirmation. Never paste the secret
# in a chat. NOTION_PARENT_PAGE_ID (optional) is the page where new notes go
# when you don't say another: the 32 characters at the end of its link.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=

# --- Telegram (optional): talk to Eddie from your phone, text or voice notes ---
# Create the bot with @BotFather (/newbot) and keep its token here, never in a
# chat. TELEGRAM_WEBHOOK_SECRET is any random 20-64 character string (letters,
# digits, _ or -): Telegram sends it back with every update. Needs APP_URL
# (https), DATABASE_URL and db/migrations/0002_telegram.sql. Then Conectores >
# Telegram > "Vincular Telegram" in the app. See README.md "Telegram".
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Recordatorios y resumen de la mañana por Telegram: clave (mínimo 16
# caracteres, al azar; p. ej. `openssl rand -hex 32`) con la que el trabajo
# programado llama a /api/connectors/cron. El mismo valor va como secreto
# CRON_SECRET en GitHub (Settings → Secrets and variables → Actions).
CRON_SECRET=

# --- WhatsApp (optional): talk to Eddie from WhatsApp, text, voice notes and photos ---
# Meta's WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp). Needs
# APP_URL (https), DATABASE_URL and db/migrations/0005_whatsapp.sql. WHATSAPP_TOKEN
# is a System User token (a temporary 24 h one works for a first test),
# WHATSAPP_PHONE_NUMBER_ID is on the API Setup page, WHATSAPP_APP_SECRET is in App
# settings > Basic, and WHATSAPP_VERIFY_TOKEN is any random string you invent (type
# the same one in the webhook form). Webhook URL: APP_URL/api/connectors/whatsapp/webhook,
# subscribed to "messages". Never paste these in a chat. See README.md "WhatsApp".
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional: Graph API version (default v23.0).
WHATSAPP_GRAPH_VERSION=

# --- EDDIE Prime (optional): the agent on your own computer ---
# Needs nothing new (DATABASE_URL + migration 0006). The agent waits for a
# data-less "doorbell" on a secret ntfy topic; set this only to use your own
# ntfy server (https). See docs/eddie-prime-agente.md.
EDDIE_NTFY_URL=

# --- OpenRouter (optional): one key, hundreds of models ---
# https://openrouter.ai/keys. Default model is "openrouter/free" (picks a
# free model per request; free models allow 20 requests/minute and 50/day).
# Also a backup after Groq when the chosen provider fails.
OPENROUTER_API_KEY=
# Optional: any model id from https://openrouter.ai/models
OPENROUTER_MODEL=

# --- Google Sign-In + Calendar + Drive (optional) ---
# Without these, Eddie works exactly as before: no login, everything
# stored in the browser's localStorage. See README.md "Cuenta de Google"
# for how to create these in Google Cloud Console.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback

# The frontend's own URL — where the OAuth callback redirects back to
# after a successful login.
APP_URL=http://localhost:5173

# Encrypts the stored Google access (AES-256-GCM) and is required to
# connect Gmail (Conectores → Conectar Gmail). A long random string, at
# least 16 characters; don't change it later or saved access stops working.
CONNECTOR_SECRET=

# --- Database (required only if using Google Sign-In) ---
# Postgres connection string, e.g. from Neon (https://neon.tech, free tier).
DATABASE_URL=

# Port for the local Express dev server (server/dev-server.js). Optional.
PORT=8787

# --- Spotify (optional): music by voice, from Conectores → Conectar Spotify ---
# Create an app at https://developer.spotify.com/dashboard, add the Redirect URI
# APP_URL/api/connectors/spotify/callback (or SPOTIFY_REDIRECT_URI) and, while it is in
# development mode, your Spotify e-mail under User Management. Needs CONNECTOR_SECRET,
# DATABASE_URL, APP_URL and db/migrations/0007_spotify.sql. Controlling playback needs
# Spotify Premium and Spotify open on some device.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
