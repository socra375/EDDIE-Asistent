{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/connectors/:path*", "destination": "/api/connectors?path=:path*" },
    { "source": "/api/tasks/:id", "destination": "/api/tasks?id=:id" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/chat.js": {
      "maxDuration": 60
    },
    "api/connectors.js": {
      "maxDuration": 60
    }
  }
}
