{
  "manifest_version": 3,
  "name": "Eddie",
  "version": "1.2.1",
  "description": "Eddie en Chrome",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "Eddie",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "storage",
    "debugger",
    "sidePanel",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://eddie-asistent.vercel.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://eddie-asistent.vercel.app/*"
    ]
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-eddie-panel": {
      "suggested_key": {
        "default": "Alt+E",
        "mac": "Alt+E"
      },
      "description": "Abrir Eddie en el panel lateral"
    }
  }
}
