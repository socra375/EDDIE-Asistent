{
  "manifest_version": 3,
  "name": "Eddie en tu navegador",
  "version": "1.1.0",
  "description": "Deja que Eddie abra tus reuniones a su hora, tus documentos y las páginas que le pidas, y (con tu confirmación) controle una pestaña para cumplir una tarea en una web, en este navegador.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_title": "Eddie en tu navegador",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "storage",
    "debugger"
  ],
  "host_permissions": [
    "https://eddie-asistent.vercel.app/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://eddie-asistent.vercel.app/*"
    ]
  }
}
